# .env.example — placeholders only. Copy to .env for local development.
# Never commit real keys, tokens, interview audio, or candidate transcripts.

# --- LiveKit (in-app WebRTC call) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
JOIN_TOKEN_TTL_SECONDS=600

# --- Server-side analysis worker ---
ANALYSIS_WORKER_ENABLED=true
ANALYSIS_SAMPLE_RATE_HZ=16000

# --- Transcription ---
# "none" disables live STT (use the dev transcript form to simulate).
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=replace_me

# --- Privacy / operations ---
AUDIO_RETENTION_HOURS=0
MAX_SESSION_MINUTES=90
LOG_LEVEL=INFO

# Enables /api/sessions/{id}/dev/* helpers. Set to false outside development.
DEV_MODE=true
